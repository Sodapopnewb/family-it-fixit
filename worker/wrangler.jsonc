// Family Fix-It report receiver. Deploy from this folder:  wrangler deploy
// The ids below are the ones already in use by the deployed worker (KV "family-fixit-reports", Durable Object RateLimiter).
// Email goes out through the Gmail API as the Family Fix-It Gmail account (OAuth refresh token). It stays OFF until the three
// secrets exist, and nothing is emailed without them (every report is then kept in KV for Trey, as before). Set them once:
//   wrangler secret put GMAIL_CLIENT_ID
//   wrangler secret put GMAIL_CLIENT_SECRET
//   wrangler secret put GMAIL_REFRESH_TOKEN      (made by ./get-gmail-token, see GMAIL-SETUP.md)
{
  "name": "fixit-report",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "kv_namespaces": [
    { "binding": "REPORTS", "id": "9f101a656c6540859b9d1d6261af733a" }
  ],
  "durable_objects": {
    "bindings": [ { "name": "LIMITER", "class_name": "RateLimiter" } ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": [ "RateLimiter" ] }
  ],
  "vars": {
    // The From line of every email. Must be the Gmail account whose refresh token is stored in GMAIL_REFRESH_TOKEN.
    "MAIL_FROM": "Family Fix-It <familyfixit.help@gmail.com>",
    // Trey's own address (reports for Trey go here too, and a helper with this address is treated as Trey). Optional.
    // "REPORT_TO": "trey@example.com",
    // Extra addresses treated as Trey (comma separated). Optional; default is REPORT_TO.
    // "OPERATOR_EMAILS": "trey@example.com",
    // The public address of this worker, used in the links in the emails. Default: the address the request came in on.
    // "PUBLIC_URL": "https://fixit-report.hg-fixit.workers.dev",
    // Daily caps. A consumer Gmail account may send about 500 messages a day, so these stay well under it:
    // 100 confirm emails, 200 helper report emails, 300 emails in all (Trey's own copies may use 50 more).
    "MAX_CONFIRMS_PER_DAY": "100",
    "MAX_MAILS_PER_DAY": "200",
    "MAX_TOTAL_MAILS_PER_DAY": "300"
  }
}
